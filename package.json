{
  "name": "gitview",
  "version": "1.2.0",
  "description": "Git graph by lanes in the terminal, with single-file HTML export",
  "author": "Gabriel Kleemann Duarte <gabrielkleemannd@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dduartee/gitview.git"
  },
  "bin": {
    "gitview": "gitview.ts"
  },
  "scripts": {
    "start": "bun gitview.ts",
    "dump": "bun gitview.ts --dump",
    "export": "bun gitview.ts --export grafo.html",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "depcruise packages gitview.ts",
    "sinks": "bun script/sinks.ts",
    "density": "bun script/line-density.ts",
    "check": "bun run sinks && bun run typecheck && bun run lint:boundaries && bun test"
  },
  "dependencies": {
    "@opentui/core": "^0.5.17"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dependency-cruiser": "^18.6.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}