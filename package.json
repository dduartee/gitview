{
  "name": "gitview",
  "version": "1.2.0",
  "description": "Grafo do git por lanes no terminal, com export HTML de um arquivo so",
  "author": "Gabriel Kleemann Duarte <gabrielkleemannd@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dduartee/gitview.git"
  },
  "bin": {
    "gitview": "gitview.ts"
  },
  "scripts": {
    "start": "bun gitview.ts",
    "dump": "bun gitview.ts --dump",
    "export": "bun gitview.ts --export grafo.html",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "^0.5.17"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}